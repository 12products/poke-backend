generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reminder {
  id               String    @id @default(uuid())
  text             String
  notificationTime DateTime  @db.Timestamptz(6)
  // 0 indexed; 0 = Sunday, 6 = Saturday, etc.
  notificationDays Int[]
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  message          Message?
  emoji            String
  color            String    @default("blue")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  timeZone         String
  isActive         Boolean   @default(true)
  priority         Int       @default(1)
  tags             String[]  @default([])
  history          ReminderHistory[]

  @@index([userId])
  @@index([notificationTime])
  @@index([isActive])
}

model User {
  id                 String     @id @default(uuid())
  name               String?
  email              String?    @unique
  phone              String     @unique
  onboarded          Boolean    @default(false)
  reminders          Reminder[]
  activeSubscription String?
  createdAt          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(6)
  lastActiveAt       DateTime?  @db.Timestamptz(6)
  preferences        Json?
  role               String     @default("user")

  @@index([phone])
  @@index([email])
}

model Message {
  id         String   @id @default(uuid())
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  reminderId String   @unique
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  nextSend   DateTime @default(now()) @db.Timestamptz(6)
  tries      Int      @default(1)
  active     Boolean  @default(false)
  status     MessageStatus @default(PENDING)
  errorMessage String?

  @@index([nextSend])
  @@index([active])
}

model ReminderHistory {
  id          String   @id @default(uuid())
  reminder    Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  reminderId  String
  action      String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  metadata    Json?

  @@index([reminderId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  ACKNOWLEDGED
}
