# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://admin:password@localhost:5432/poke

# ===========================================
# Twilio Configuration
# ===========================================
# Your Twilio Account SID (found in Twilio Console)
TWILIO_ACCOUNT_ID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Your Twilio Auth Token (found in Twilio Console)
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number in E.164 format
TWILIO_PHONE=+15555555555

# ===========================================
# Apple In-App Purchase Configuration
# ===========================================
# Shared secret for verifying Apple receipts
# Generate this in App Store Connect
APPLE_SHARED_SECRET=your_shared_secret_here

# ===========================================
# Server Configuration (Optional)
# ===========================================
# Port to run the server on (default: 3000)
# PORT=3000

# Node environment (development, production, test)
# NODE_ENV=development
